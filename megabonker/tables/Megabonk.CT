<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Megabonk Trainer  -- ENABLE THIS FIRST, then jump once"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Megabonk trainer - activation

  Installs the hooks and publishes two pointers:
    pPlayer  -&gt; player object   (health at +10)
    pStats2  -&gt; stat array base (stat id N at +1C + N*10)

  This script makes NO gameplay change on its own. Godmode is a separate
  entry underneath, gated on the gGodmode flag.

  After enabling, JUMP ONCE so the stat getter runs and pStats2 populates.
}

[ENABLE]

aobscanmodule(healthSet,GameAssembly.dll,89 7B 10 48 8B 05 46 47 B4 02)
aobscanmodule(healthDmg,GameAssembly.dll,89 47 10 83 7F 10 00 0F 8F)
aobscanmodule(statAob,GameAssembly.dll,70 E8 71 62 49 FF 33 D2 48 8B C8 E8 47 C6 72 00 0F 57 C0 48 8B 5C 24 30 48 8B 74 24 40 48 83 C4 20 5F C3 48 8B 4B 18 48 85 C9 74 20 3B 41 18 73 21 48 8B 5C 24 30 48 8B 74 24 40 48 98 48 03 C0 F3 0F 10 44 C1 2C 48 83 C4 20 5F C3)
alloc(newmem,$1000,healthSet)
alloc(newmem2,$1000,healthDmg)
alloc(newmem4,$1000,statAob)
alloc(pPlayer,8)
alloc(pStats2,8)
alloc(gGodmode,4)

label(code)   label(return)   label(skipwrite)
label(code2)  label(return2)  label(skipwrite2)
label(skip4)  label(return4)
registersymbol(pPlayer)
registersymbol(pStats2)
registersymbol(gGodmode)
registersymbol(healthSet)
registersymbol(healthDmg)
registersymbol(statAob)

gGodmode:
  dd 0

// --- health: clamped setter (heals / init) ---
newmem:
  mov [pPlayer],rbx
  cmp dword ptr [gGodmode],0
  je code
  cmp edi,[rbx+10]
  jl skipwrite
code:
  mov [rbx+10],edi
skipwrite:
  mov rax,[GameAssembly.dll+2F6D478]
  jmp return

healthSet:
  jmp newmem
  nop 5
return:

// --- health: damage apply (death check follows) ---
newmem2:
  mov [pPlayer],rdi
  cmp dword ptr [gGodmode],0
  je code2
  cmp eax,[rdi+10]
  jl skipwrite2
code2:
  mov [rdi+10],eax
skipwrite2:
  cmp dword ptr [rdi+10],00
  jmp return2

healthDmg:
  jmp newmem2
  nop 2
return2:

// --- stats: capture array base when Jump Height (id 27) is read ---
newmem4:
  pushfq
  cmp rax,34
  jne skip4
  mov [pStats2],rcx
skip4:
  popfq
  movss xmm0,[rcx+rax*8+2C]
  jmp return4

statAob+40:
  jmp newmem4
  nop
return4:

[DISABLE]

healthSet:
  db 89 7B 10 48 8B 05 46 47 B4 02
healthDmg:
  db 89 47 10 83 7F 10 00
statAob+40:
  db F3 0F 10 44 C1 2C

unregistersymbol(healthSet)
unregistersymbol(healthDmg)
unregistersymbol(statAob)
unregistersymbol(pPlayer)
unregistersymbol(pStats2)
unregistersymbol(gGodmode)
dealloc(newmem)
dealloc(newmem2)
dealloc(newmem4)
dealloc(pPlayer)
dealloc(pStats2)
dealloc(gGodmode)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>2</ID>
          <Description>"Godmode (block damage)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Blocks any health write that would lower it.
  Heals and max-HP increases still apply.
  Requires the activation script above. }

[ENABLE]
gGodmode:
  dd 1

[DISABLE]
gGodmode:
  dd 0
</AssemblerScript>
