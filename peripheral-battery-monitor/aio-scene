#!/usr/bin/env python3
"""Apply a lighting/LCD scene in the running monitor (spec 025).

Usage:
    aio-scene <N>       apply scene N (1-9 colours, 11-19 animations)
    aio-scene --list    show what each slot does

Bound to Ctrl+Alt+Numpad N by .desktop entries in kglobalshortcutsrc. Talks to
the monitor over D-Bus rather than driving the hardware itself, because every
liquidctl call has to be serialised by the monitor's queue against the 5 s
status poll.

Exits non-zero with one line when the monitor is not running: a keypress should
not produce a dialog or a hang.
"""

import os
import sys

SERVICE = "org.agscripts.PeripheralBatteryMonitor"
PATH = "/Scenes"
IFACE = "org.agscripts.Scenes"
TIMEOUT_MS = 3000


def _call(method: str, *args):
    from PyQt6.QtCore import QCoreApplication
    from PyQt6.QtDBus import QDBusConnection, QDBusInterface

    app = QCoreApplication(sys.argv)  # noqa: F841 - bus needs an event loop owner
    bus = QDBusConnection.sessionBus()
    if not bus.isConnected():
        print("aio-scene: no session D-Bus", file=sys.stderr)
        return None

    iface = QDBusInterface(SERVICE, PATH, IFACE, bus)
    iface.setTimeout(TIMEOUT_MS)
    if not iface.isValid():
        print("aio-scene: peripheral-battery-monitor is not running",
              file=sys.stderr)
        return None

    reply = iface.call(method, *args)
    from PyQt6.QtDBus import QDBusMessage
    if reply.type() != QDBusMessage.MessageType.ReplyMessage:
        print(f"aio-scene: {reply.errorMessage() or 'call failed'}",
              file=sys.stderr)
        return None
    arguments = reply.arguments()
    return arguments[0] if arguments else None


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help") else 2

    if argv[0] == "--list":
        listing = _call("List")
        if listing is None:
            return 1
        print(listing)
        return 0

    # Range lives in aio_scenes, not here: hardcoding 1-9 in this file is what
    # made the animation bank unreachable from the CLI after it was added.
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import aio_scenes

    try:
        slot = int(argv[0])
    except ValueError:
        print(f"aio-scene: not a slot number: {argv[0]}", file=sys.stderr)
        return 2
    if not aio_scenes.valid_slot(slot):
        print(f"aio-scene: slot out of range "
              f"({aio_scenes.SLOT_MIN}-{aio_scenes.SLOT_MAX}, "
              f"{aio_scenes.ANIM_MIN}-{aio_scenes.ANIM_MAX}): {slot}",
              file=sys.stderr)
        return 2

    applied = _call("Apply", slot)
    if applied is None:
        return 1
    if not applied:
        print(f"aio-scene: scene {slot} applied nothing", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
